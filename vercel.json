{
  "version": 2,
  "builds": [
    {
      "src": "apps/backend/dist/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/backend/dist/generated/client/**",
          "apps/backend/prisma/dev.db",
          "apps/backend/prisma/schema.prisma"
        ]
      }
    },
    {
      "src": "apps/mock-bse/dist/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "apps/dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/bse/(.*)",
      "dest": "apps/mock-bse/dist/server.js"
    },
    {
      "src": "/api/internal/(.*)",
      "dest": "apps/mock-bse/dist/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "apps/backend/dist/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "apps/dashboard/$1"
    }
  ]
}
